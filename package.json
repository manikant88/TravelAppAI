{
  "name": "cleartrip-ai-trip-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:seed:images": "tsx src/db/seed/pexels-images.ts",
    "db:sync:images": "tsx src/db/seed/sync-images.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:verify-runtime": "tsx src/db/verify-runtime.ts",
    "inventory:verify": "tsx src/inventory/verify-runtime.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-orm": "^0.45.0",
    "next": "^16.0.0",
    "openai": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.1.0",
    "vitest": "^3.0.0"
  }
}
