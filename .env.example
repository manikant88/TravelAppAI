DATABASE_URL=
DATABASE_ADMIN_URL=
INVENTORY_SOURCE=snapshot
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional global override for every OpenAI request. Per-request overrides win.
OPENAI_TIMEOUT_MS=
# Recommended defaults: copy only when deployment-specific tuning is needed.
OPENAI_COMMUNICATION_TIMEOUT_MS=20000
OPENAI_CONTEXT_TIMEOUT_MS=20000
OPENAI_DISCOVERY_TIMEOUT_MS=25000
OPENAI_PLANNING_TIMEOUT_MS=30000
# Optional reasoning overrides: minimal, low, medium, or high.
OPENAI_REASONING_EFFORT=
OPENAI_COMMUNICATION_REASONING_EFFORT=minimal
OPENAI_CONTEXT_REASONING_EFFORT=minimal
OPENAI_DISCOVERY_REASONING_EFFORT=low
OPENAI_PLANNING_REASONING_EFFORT=low
INVENTORY_VERSION=travel-seed-v2
PEXELS_API_KEY=
PEXELS_IMAGE_LIMIT=
PEXELS_RESULTS_PER_TARGET=8

# Google Maps live planner: browser map plus server-side Places and Routes calls.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Match the local server key IPv4 allowlist on dual-stack networks.
GOOGLE_MAPS_PREFER_IPV4=true

# Server-only Nuitée Connect hotel search. Sandbox keys begin with sand_.
# The same key powers the optional Flights sandbox after Flights access is enabled.
NUITEE_API_KEY=
NUITEE_API_BASE_URL=https://api.liteapi.travel
NUITEE_GUEST_NATIONALITY=IN
